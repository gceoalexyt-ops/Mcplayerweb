{
  "name": "Minecraft Web Player",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "secrets": {
    "MS_CLIENT_ID": {
      "description": "Application (client) ID of your Azure app registration",
      "documentationUrl": "https://github.com/gceoalexyt-ops/Mcplayerweb#microsoft--azure-setup-required"
    },
    "MS_CLIENT_SECRET": {
      "description": "Client secret of your Azure app registration",
      "documentationUrl": "https://github.com/gceoalexyt-ops/Mcplayerweb#microsoft--azure-setup-required"
    }
  },
  "containerEnv": {
    "SCREEN_WIDTH": "1024",
    "SCREEN_HEIGHT": "576",
    "VIDEO_BITRATE_KBPS": "3000",
    "MC_MAX_MEMORY_MB": "2560",
    "MAX_SESSIONS": "1"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "npm start",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Minecraft", "onAutoForward": "openBrowser" }
  }
}
