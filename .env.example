# Public URL of this site, exactly as users open it (no trailing slash).
# The Azure redirect URI must be BASE_URL + /auth/callback
BASE_URL=http://localhost:3000
PORT=3000

# Long random string used to sign session cookies:  openssl rand -hex 32
SESSION_SECRET=

# Azure app registration (see README: "Microsoft / Azure setup")
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Set to 1 when running behind a reverse proxy that terminates HTTPS
TRUST_PROXY=0

# Where game files, worlds and settings are stored
DATA_DIR=./data

# How many people can play at the same time (each game needs ~2-4 GB RAM and a few CPU cores)
MAX_SESSIONS=2
# Stop a game after this many minutes with nobody watching it
IDLE_TIMEOUT_MINUTES=10

# Stream settings
SCREEN_WIDTH=1280
SCREEN_HEIGHT=720
STREAM_FPS=30
VIDEO_BITRATE_KBPS=4000
AUDIO=1

# Max Java heap for each game, in MB
MC_MAX_MEMORY_MB=3072
# Leave empty to use Mojang's official Java runtime (downloaded automatically)
JAVA_PATH=
